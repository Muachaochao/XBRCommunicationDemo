<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:arc="https://github.com/AIDotNet/TKCode.Arc" xmlns:models="using:Xbr.Desktop.Models" xmlns:vm="using:Xbr.Desktop.ViewModels" x:Class="Xbr.Desktop.Views.MainWindow" x:DataType="vm:MainViewModel" Title="XBR Communication Studio · 工业通信工作台" Width="1240" Height="880" MinWidth="1000" MinHeight="700" Background="#101820" Foreground="#DBE4EA">
<Window.Styles>
<Style Selector="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,8"/></Style>

<Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#9DAFBC"/><Setter Property="FontSize" Value="12"/></Style>
<Style Selector="Button"><Setter Property="Padding" Value="18,9"/></Style>
</Window.Styles>
<Grid ColumnDefinitions="180,*" RowDefinitions="80,*,36">
<Border Grid.RowSpan="3" Background="#15222D" Padding="20,26"><StackPanel Spacing="18"><TextBlock Text="XBR" FontSize="28" FontWeight="Bold" Foreground="#59D5C6"/><TextBlock Text="COMMUNICATION STUDIO" FontSize="10"/><Border Height="1" Background="#30414D"/><TextBlock Text="协议工作台" Classes="caption"/><arc:Button Content="Modbus TCP" Command="{Binding SelectWorkspaceCommand}" CommandParameter="0"/><arc:Button Content="PLC 模拟器" Command="{Binding SelectWorkspaceCommand}" CommandParameter="8"/><arc:Button Content="工业 PLC" Command="{Binding SelectWorkspaceCommand}" CommandParameter="9"/><arc:Button Content="协议目录" Command="{Binding SelectWorkspaceCommand}" CommandParameter="10"/><TextBlock Text="迁移验证版" Classes="caption" Margin="0,30,0,0"/><TextBlock Text="TKCode.Arc 组件&#10;功能逐项验收中。" TextWrapping="Wrap" Classes="caption"/></StackPanel></Border>
<Grid Grid.Column="1" Margin="26,18" ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding WorkspaceTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="工业协议读写 · 虚拟 PLC · 数据采集" Classes="caption"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#59D5C6" VerticalAlignment="Center"/></Grid>
<ScrollViewer Grid.Row="1" Grid.Column="1" Margin="26,0,26,10" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
<Border Background="#192630" CornerRadius="8" Padding="18" IsVisible="{Binding IsModbusWorkspace}"><StackPanel Spacing="12"><TextBlock Text="01 / 连接参数" FontWeight="SemiBold"/>
<StackPanel Spacing="10" IsEnabled="{Binding CanEditConnection}">
<Grid ColumnDefinitions="2*,*,*,*,*">
<StackPanel Margin="0,0,10,0"><TextBlock Text="主机地址" Classes="caption"/><TextBox Text="{Binding Host}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="端口" Classes="caption"/><TextBox Text="{Binding Port}"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="站号" Classes="caption"/><TextBox Text="{Binding Station}"/></StackPanel>
<StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="连接超时 / ms" Classes="caption"/><TextBox Text="{Binding ConnectTimeout}"/></StackPanel>
<StackPanel Grid.Column="4"><TextBlock Text="接收超时 / ms" Classes="caption"/><TextBox Text="{Binding ReceiveTimeout}"/></StackPanel></Grid>
<Grid ColumnDefinitions="*,*,*,*"><StackPanel Margin="0,0,10,0"><TextBlock Text="字节序" Classes="caption"/><ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="广播站号（空 = 禁用）" Classes="caption"/><TextBox Text="{Binding Broadcast}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="字分批长度（空 = 120）" Classes="caption"/><TextBox Text="{Binding BatchLength}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="PLC 地址映射" Classes="caption"/><ComboBox ItemsSource="{Binding AddressMappings}" SelectedIndex="{Binding AddressMappingIndex}" HorizontalAlignment="Stretch"/></StackPanel></Grid>
<WrapPanel><CheckBox Content="地址从 0 开始" IsChecked="{Binding AddressZero}" Margin="0,0,16,0"/><CheckBox Content="字符串反转" IsChecked="{Binding StringReverse}" Margin="0,0,16,0"/><CheckBox Content="检查消息号" IsChecked="{Binding MessageCheck}" Margin="0,0,16,0"/><CheckBox Content="检查站号" IsChecked="{Binding StationCheck}" Margin="0,0,16,0"/><CheckBox Content="禁用功能码 06" IsChecked="{Binding Disable06}"/></WrapPanel></StackPanel>
<StackPanel Orientation="Horizontal" Spacing="10"><arc:Button Content="连接设备" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanEditConnection}" Background="#257F78"/><arc:Button Content="断开连接" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}"/></StackPanel></StackPanel></Border>
<TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding WorkspaceIndex}">
<TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></TabControl.ItemsPanel>
<TabItem Header="寄存器读写"><StackPanel Spacing="12" Margin="0,14"><Grid ColumnDefinitions="2*,*,*" IsEnabled="{Binding CanOperate}"><StackPanel Margin="0,0,10,0"><TextBlock Text="地址" Classes="caption"/><TextBox Text="{Binding Address}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="数据类型" Classes="caption"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding DataType}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="读取数量 / 字符串字节长度" Classes="caption"/><TextBox Text="{Binding Length}"/></StackPanel></Grid>
<Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding CanOperate}"><arc:Button Content="读取" Command="{Binding ReadCommand}"/><TextBox Grid.Column="1" Text="{Binding WriteValue}" Margin="10,0" PlaceholderText="值或逗号分隔数组；字符串使用 UTF-8"/><arc:Button Grid.Column="2" Content="写入" Command="{Binding WriteCommand}"/></Grid>
<StackPanel Orientation="Horizontal" Spacing="10"><TextBox Text="{Binding Interval}" Width="100" IsEnabled="{Binding CanOperate}"/><TextBlock Text="ms" VerticalAlignment="Center"/><arc:Button Content="开始轮询" Command="{Binding StartPollingCommand}" IsEnabled="{Binding CanOperate}"/><arc:Button Content="停止轮询" Command="{Binding StopPollingCommand}" IsEnabled="{Binding IsPolling}"/></StackPanel></StackPanel></TabItem>
<TabItem Header="原始报文"><StackPanel Spacing="12" Margin="0,14" IsEnabled="{Binding CanOperate}"><TextBlock Text="Hex 请求；完整报文模式需要包含 MBAP 头。" Classes="caption"/><TextBox Text="{Binding RawHex}"/><CheckBox Content="Modbus Core：由库添加协议头" IsChecked="{Binding CoreMessage}"/><arc:Button Content="发送报文" Command="{Binding SendRawCommand}"/></StackPanel></TabItem>
<TabItem Header="连接配置"><StackPanel Spacing="12" Margin="0,14"><TextBlock Text="单设备明文 XML；保存前自动备份已有文件。" Classes="caption"/><TextBox Text="{Binding ConfigPath}"/><StackPanel Orientation="Horizontal" Spacing="10"><arc:Button Content="加载配置" Command="{Binding LoadConfigCommand}" IsEnabled="{Binding CanEditConnection}"/><arc:Button Content="保存配置" Command="{Binding SaveConfigCommand}"/></StackPanel></StackPanel></TabItem>

<TabItem Header="特殊功能 · FC23"><StackPanel Spacing="10" Margin="0,14" IsEnabled="{Binding CanOperate}">
<TextBlock Text="一次请求读写多个保持寄存器；写入值为 Hex 字节。" Classes="caption"/>
<Grid ColumnDefinitions="*,*,*"><StackPanel Margin="0,0,10,0"><TextBlock Text="读取地址" Classes="caption"/><TextBox Text="{Binding SpecialReadAddress}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="读取长度 / 字" Classes="caption"/><TextBox Text="{Binding SpecialReadLength}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="写入地址" Classes="caption"/><TextBox Text="{Binding SpecialWriteAddress}"/></StackPanel></Grid>
<TextBox Text="{Binding SpecialWriteHex}" PlaceholderText="写入值，例如 00 01 00 02"/>
<arc:Button Content="读写寄存器（功能码 23）" Command="{Binding ReadWriteCommand}"/>
<TextBox Text="{Binding SpecialCode}" IsReadOnly="True" TextWrapping="Wrap"/>
</StackPanel></TabItem>
<TabItem Header="站号搜索"><StackPanel Spacing="10" Margin="0,14">
<Grid ColumnDefinitions="*,*,*,*,*" IsEnabled="{Binding CanOperate}">
<StackPanel Margin="0,0,10,0"><TextBlock Text="起始站号" Classes="caption"/><TextBox Text="{Binding SearchStart}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="终止站号" Classes="caption"/><TextBox Text="{Binding SearchEnd}"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="接收超时 / ms" Classes="caption"/><TextBox Text="{Binding SearchTimeout}"/></StackPanel>
<StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="读取地址" Classes="caption"/><TextBox Text="{Binding SearchAddress}"/></StackPanel>
<StackPanel Grid.Column="4"><TextBlock Text="读取长度" Classes="caption"/><TextBox Text="{Binding SearchLength}"/></StackPanel></Grid>
<StackPanel Orientation="Horizontal" Spacing="16" IsEnabled="{Binding CanOperate}"><CheckBox Content="Word 读取（关闭时读 Bool）" IsChecked="{Binding SearchWord}"/><CheckBox Content="匹配即停止" IsChecked="{Binding StopOnMatch}"/></StackPanel>
<StackPanel Orientation="Horizontal" Spacing="10"><arc:Button Content="开始搜索" Command="{Binding SearchStationsCommand}" IsEnabled="{Binding CanOperate}"/><arc:Button Content="停止搜索" Command="{Binding StopSearchCommand}" IsEnabled="{Binding IsSearching}"/></StackPanel>
<Grid ColumnDefinitions="*,*"><TextBox Text="{Binding SearchLog}" IsReadOnly="True" TextWrapping="Wrap" Height="130" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding SearchMatches}" IsReadOnly="True" TextWrapping="Wrap" Height="130"/></Grid>
</StackPanel></TabItem>

<TabItem Header="批量读取"><StackPanel Spacing="10" Margin="0,14">
<Grid ColumnDefinitions="2*,*,*,*" IsEnabled="{Binding CanOperate}"><StackPanel Margin="0,0,10,0"><TextBlock Text="起始地址" Classes="caption"/><TextBox Text="{Binding BatchAddress}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="读取长度 / 字" Classes="caption"/><TextBox Text="{Binding BatchCount}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="显示 / 写入格式" Classes="caption"/><ComboBox ItemsSource="{Binding BatchDisplays}" SelectedItem="{Binding BatchDisplay}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="每行数量（空 = 自动）" Classes="caption"/><TextBox Text="{Binding BatchLineCount}"/></StackPanel></Grid>
<StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanOperate}"><CheckBox Content="按字反转显示" IsChecked="{Binding BatchReverse}"/><arc:Button Content="批量读取" Command="{Binding ReadBatchCommand}"/><arc:Button Content="重新解析缓存" Command="{Binding RenderBatchCommand}"/><arc:Button Content="批量写入" Command="{Binding WriteBatchCommand}"/></StackPanel>
<TextBlock Text="{Binding BatchInfo}" Classes="caption"/><TextBox Text="{Binding BatchContent}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="150" SelectionStart="{Binding BatchSelectionStart, Mode=OneWay}" SelectionEnd="{Binding BatchSelectionEnd, Mode=OneWay}"/>
<Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBox Text="{Binding BatchSearch}" PlaceholderText="查找文本或正则"/><CheckBox Grid.Column="1" Content="正则" IsChecked="{Binding BatchSearchRegex}" Margin="10,0"/><arc:Button Grid.Column="2" Content="查找" Command="{Binding FindBatchTextCommand}" Margin="0,0,10,0"/><TextBlock Grid.Column="3" Text="{Binding BatchSearchInfo}" Classes="caption" VerticalAlignment="Center"/></Grid>
<TextBlock Text="修改格式、反转或每行数量只重新解析缓存；显示反转与行宽不改变写入字节；Bits 不支持反写。" Classes="caption"/>
<StackPanel Orientation="Horizontal" Spacing="10"><CheckBox Content="启用解析子表" IsChecked="{Binding BatchParseEnabled}"/><arc:Button Content="添加解析行" Command="{Binding AddBatchParseRowCommand}"/><arc:Button Content="删除选中" Command="{Binding RemoveBatchParseRowCommand}"/></StackPanel>
<DataGrid ItemsSource="{Binding BatchParseRows}" SelectedItem="{Binding SelectedBatchParseRow}" AutoGenerateColumns="False" Height="155" CanUserResizeColumns="True">
<DataGrid.Columns>
<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120"/>
<DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
<DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="80"/>
<DataGridTextColumn Header="字节索引" Binding="{Binding ByteIndex}" Width="80"/>
<DataGridTextColumn Header="解析值" Binding="{Binding Value}" Width="180" IsReadOnly="True"/>
<DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="220" IsReadOnly="True"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="代码示例" Classes="caption"/><TextBox Text="{Binding BatchCode}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="145"/>
</StackPanel></TabItem>
<TabItem Header="数据表"><StackPanel Spacing="10" Margin="0,14">
<StackPanel Orientation="Horizontal" Spacing="8"><arc:Button Content="添加点位" Command="{Binding AddTagCommand}" IsEnabled="{Binding CanEditTable}"/><arc:Button Content="删除选中" Command="{Binding RemoveTagCommand}" IsEnabled="{Binding CanEditTable}"/><arc:Button Content="读取一轮" Command="{Binding ReadTableCommand}" IsEnabled="{Binding CanOperate}"/><arc:Button Content="开始采集" Command="{Binding StartTableCommand}" IsEnabled="{Binding CanOperate}"/><arc:Button Content="停止采集" Command="{Binding StopTableCommand}" IsEnabled="{Binding IsMonitoring}"/></StackPanel>
<Grid ColumnDefinitions="Auto,90,Auto,90,*"><TextBlock Text="周期间隔 / ms" VerticalAlignment="Center" Classes="caption"/><TextBox Grid.Column="1" Text="{Binding TableInterval}" Margin="8,0" IsEnabled="{Binding CanEditTable}"/><TextBlock Grid.Column="2" Text="点间休眠 / ms" VerticalAlignment="Center" Classes="caption"/><TextBox Grid.Column="3" Text="{Binding TableSleep}" Margin="8,0" IsEnabled="{Binding CanEditTable}"/><TextBlock Grid.Column="4" Text="{Binding TableStatus}" VerticalAlignment="Center"/></Grid>
<DataGrid x:Name="TagGrid" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" AutoGenerateColumns="False" CanUserResizeColumns="True" Height="250" IsReadOnly="False" IsEnabled="{Binding CanEditTable}">
<DataGrid.Columns>
<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
<DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="85"/>
<DataGridTemplateColumn Header="类型" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="models:TagRow"><ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding DataTypeCode, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="60"/>
<DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="140" IsReadOnly="True"/>
<DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="55"/>
<DataGridTextColumn Header="表达式 x" Binding="{Binding Expression}" Width="100"/>
<DataGridTemplateColumn Header="字符串编码" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="models:TagRow"><ComboBox ItemsSource="{Binding AvailableEncodings}" SelectedItem="{Binding Encoding, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridCheckBoxColumn Header="曲线" Binding="{Binding IsPlotted, Mode=TwoWay}" Width="50"/>
<DataGridTextColumn Header="颜色" Binding="{Binding CurveColor}" Width="90"/>
<DataGridCheckBoxColumn Header="虚线" Binding="{Binding CurveDashed, Mode=TwoWay}" Width="50"/>
<DataGridTextColumn Header="更新时间" Binding="{Binding LastUpdated}" Width="110" IsReadOnly="True"/>
<DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="180" IsReadOnly="True"/>
<DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="120"/>
</DataGrid.Columns></DataGrid>
<TextBlock Text="双击“当前值”单元格可写入并回读。官方 DataTableItem 语义：长度空白读标量，正数读数组；字符串 Length 是 HSL ReadString 的 Modbus 字长度。失败行继续下一项。" TextWrapping="Wrap" Classes="caption"/>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding TablePath}"/><arc:Button Grid.Column="1" Content="加载点表" Command="{Binding LoadTableCommand}" IsEnabled="{Binding CanEditTable}" Margin="8,0"/><arc:Button Grid.Column="2" Content="保存点表" Command="{Binding SaveTableCommand}"/></Grid>
</StackPanel></TabItem>
<TabItem Header="实时曲线"><StackPanel Spacing="10" Margin="0,14">
<Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="曲线选择与数据表联动，可同时显示多条成功标量曲线。" VerticalAlignment="Center" Classes="caption"/><arc:Button Grid.Column="1" Content="开始采集" Command="{Binding StartTableCommand}" IsEnabled="{Binding CanOperate}" Margin="8,0"/><arc:Button Grid.Column="2" Content="停止采集" Command="{Binding StopTableCommand}" IsEnabled="{Binding IsMonitoring}"/></Grid>
<ItemsControl ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:TagRow"><CheckBox IsChecked="{Binding IsPlotted, Mode=TwoWay}" Margin="0,0,16,6"><TextBlock Text="{Binding Name}"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Grid ColumnDefinitions="Auto,120,Auto,120,Auto,80,*"><CheckBox Content="平滑曲线" IsChecked="{Binding CurveSmooth}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding CurveStrokeWidth}" Margin="8,0"/><TextBlock Grid.Column="2" Text="线宽" VerticalAlignment="Center" Classes="caption"/><TextBox Grid.Column="3" Text="{Binding CurveWindowMinutes}" Margin="8,0"/><TextBlock Grid.Column="4" Text="时间窗 / 分钟（0 = 全部）" VerticalAlignment="Center" Classes="caption"/><TextBlock Grid.Column="6" Text="颜色和虚线在数据表逐点设置" VerticalAlignment="Center" Classes="caption"/></Grid>
<arc:LineChart x:Name="CurveChart" Label="{Binding CurveTitle}" ItemsSource="{Binding CurveCategories}" Height="300" ShowLegend="True" Curve="Linear"/>
<TextBlock Text="{Binding CurveSummary}" TextWrapping="Wrap" Classes="caption"/>
<TextBlock Text="只绘制成功标量；任一选中曲线失败时，该轮次会从曲线窗口剔除，不补零。数组/字符串不绘制；表格和 CSV 保留全部轮次与失败记录。" Classes="caption"/>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding HistoryPath}"/><arc:Button Grid.Column="1" Content="导出历史CSV" Command="{Binding ExportHistoryCommand}" Margin="8,0"/><arc:Button Grid.Column="2" Content="清空历史" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding CanEditTable}"/></Grid>
</StackPanel></TabItem>
<TabItem Header="PLC 模拟器"><StackPanel Spacing="10" Margin="0,14">
<Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Modbus 虚拟 PLC 服务端" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="启动虚拟 PLC，生成测试数据并验证客户端读写。" Classes="caption"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ServerStatus}" Foreground="#59D5C6" VerticalAlignment="Center"/></Grid>
<Grid ColumnDefinitions="90,90,70,140,130,*" IsEnabled="{Binding !IsServerRunning}"><StackPanel Margin="0,0,10,0"><TextBlock Text="主端口" Classes="caption"/><TextBox Text="{Binding ServerPort}" IsEnabled="{Binding !IsServerRunning}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="备用端口" Classes="caption"/><TextBox Text="{Binding ServerSecondaryPort}" IsEnabled="{Binding !IsServerRunning}"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="站号" Classes="caption"/><TextBox Text="{Binding ServerStation}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="传输" Classes="caption"/><ComboBox ItemsSource="{Binding ServerTransports}" SelectedIndex="{Binding ServerTransportIndex}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="字节序" Classes="caption"/><ComboBox ItemsSource="{Binding Formats}" SelectedIndex="{Binding ServerFormatIndex}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="地址映射" Classes="caption"/><ComboBox ItemsSource="{Binding ServerMappings}" SelectedIndex="{Binding ServerMappingIndex}" HorizontalAlignment="Stretch"/></StackPanel></Grid>
<WrapPanel IsEnabled="{Binding !IsServerRunning}"><CheckBox Content="允许远程写入" IsChecked="{Binding ServerRemoteWrite}" Margin="0,0,16,0"/><CheckBox Content="字符串反转" IsChecked="{Binding ServerStringReverse}" Margin="0,0,16,0"/><CheckBox Content="RTU over TCP" IsChecked="{Binding ServerRtuOverTcp}" Margin="0,0,16,0"/><CheckBox Content="站号数据隔离" IsChecked="{Binding ServerStationIsolation}" Margin="0,0,16,0"/><CheckBox Content="写掩码功能" IsChecked="{Binding ServerWriteMaskCode}" Margin="0,0,16,0"/><CheckBox Content="IPv6" IsChecked="{Binding ServerIpv6}"/></WrapPanel>
<StackPanel Orientation="Horizontal" Spacing="10"><arc:Button Content="启动服务端" Command="{Binding StartServerCommand}" IsEnabled="{Binding !IsServerRunning}"/><arc:Button Content="停止服务端" Command="{Binding StopServerCommand}" IsEnabled="{Binding IsServerRunning}"/><arc:Button Content="填入为本机设备" Command="{Binding UseSimulatorAsClientCommand}"/></StackPanel>
<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"><TextBlock Text="模拟写入表 · 表达式可用 x（次数）和 r（随机数）" VerticalAlignment="Center" Classes="caption"/><arc:Button Grid.Column="1" Content="添加" Command="{Binding AddSimulationRowCommand}" Margin="8,0"/><arc:Button Grid.Column="2" Content="删除选中" Command="{Binding RemoveSimulationRowCommand}" Margin="0,0,8,0"/><arc:Button Grid.Column="3" Content="单次执行" Command="{Binding RunSimulationOnceCommand}" IsEnabled="{Binding IsServerRunning}" Margin="0,0,8,0"/><arc:Button Grid.Column="4" Content="清空" Command="{Binding ClearSimulationRowsCommand}"/></Grid>
<DataGrid x:Name="SimulationGrid" ItemsSource="{Binding SimulationRows}" SelectedItem="{Binding SelectedSimulationRow}" AutoGenerateColumns="False" Height="190" CanUserResizeColumns="True" IsEnabled="{Binding !IsSimulating}">
<DataGrid.Columns>
<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="100"/>
<DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="80"/>
<DataGridTextColumn Header="周期 / ms" Binding="{Binding TimeMilliseconds}" Width="90"/>
<DataGridTextColumn Header="表达式" Binding="{Binding Expression}" Width="220"/>
<DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="140" IsReadOnly="True"/>
<DataGridTemplateColumn Header="编码" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="models:SimulationRow"><ComboBox ItemsSource="{Binding AvailableEncodings}" SelectedItem="{Binding Encoding, Mode=TwoWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="备注" Binding="{Binding Mark}" Width="100"/>
<DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="180" IsReadOnly="True"/>
</DataGrid.Columns></DataGrid>
<StackPanel Orientation="Horizontal" Spacing="10"><arc:Button Content="开始循环模拟" Command="{Binding StartSimulationCommand}" IsEnabled="{Binding IsServerRunning}"/><arc:Button Content="停止模拟" Command="{Binding StopSimulationCommand}" IsEnabled="{Binding IsSimulating}"/><TextBlock Text="无实物时可先用本机服务端完成读写、点表和曲线闭环。" Classes="caption" VerticalAlignment="Center"/></StackPanel>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding SimulationPath}"/><arc:Button Grid.Column="1" Content="加载模拟表" Command="{Binding LoadSimulationTableCommand}" IsEnabled="{Binding !IsSimulating}" Margin="8,0"/><arc:Button Grid.Column="2" Content="保存模拟表" Command="{Binding SaveSimulationTableCommand}"/></Grid>
<TextBlock Text="服务/模拟日志" Classes="caption"/><TextBox Text="{Binding SimulationLog}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="140"/>
</StackPanel></TabItem>
<TabItem Header="工业 PLC"><StackPanel Spacing="12" Margin="0,14" IsEnabled="{Binding !IndustrialBusy}">
<TextBlock Text="工业 PLC · 客户端与原生模拟服务端" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="无设备操作：选择协议 → 启动本机服务端 → 连接 → 读写。服务端内存操作不经过网络。" Classes="caption" TextWrapping="Wrap"/>
<Grid ColumnDefinitions="2*,*,*" IsEnabled="{Binding CanChangeIndustrial}"><ComboBox ItemsSource="{Binding IndustrialProtocols}" SelectedIndex="{Binding IndustrialProtocolIndex}" HorizontalAlignment="Stretch" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding IndustrialHost}" Margin="0,0,10,0"/><TextBox Grid.Column="2" Text="{Binding IndustrialPort}"/></Grid>
<WrapPanel><arc:Button Content="启动本机服务端" Command="{Binding StartIndustrialServerCommand}" IsEnabled="{Binding !IndustrialServerRunning}" Margin="0,0,8,8"/><arc:Button Content="停止服务端与连接" Command="{Binding StopIndustrialServerCommand}" IsEnabled="{Binding IndustrialServerRunning}" Margin="0,0,8,8"/><arc:Button Content="连接 PLC" Command="{Binding ConnectIndustrialCommand}" IsEnabled="{Binding !IndustrialConnected}" Margin="0,0,8,8"/><arc:Button Content="断开连接" Command="{Binding DisconnectIndustrialCommand}" IsEnabled="{Binding IndustrialConnected}" Margin="0,0,8,8"/></WrapPanel>
<Grid ColumnDefinitions="2*,*,*"><StackPanel Margin="0,0,10,0"><TextBlock Text="地址（MC/FINS: D100；S7: M100 / DB1.0）" Classes="caption"/><TextBox Text="{Binding IndustrialAddress}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="类型" Classes="caption"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding IndustrialType}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="读取数量 / 字符串长度" Classes="caption"/><TextBox Text="{Binding IndustrialCount}"/></StackPanel></Grid>
<TextBox Text="{Binding IndustrialValue}" PlaceholderText="写入值；数组使用 [1,2,3]；字符串 UTF-8"/>
<WrapPanel><arc:Button Content="客户端读取" Command="{Binding ReadIndustrialCommand}" IsEnabled="{Binding IndustrialConnected}" Margin="0,0,8,8"/><arc:Button Content="客户端写入" Command="{Binding WriteIndustrialCommand}" IsEnabled="{Binding IndustrialConnected}" Margin="0,0,8,8"/><arc:Button Content="读取服务端内存" Command="{Binding ReadIndustrialLocalCommand}" IsEnabled="{Binding IndustrialServerRunning}" Margin="0,0,8,8"/><arc:Button Content="写入服务端内存" Command="{Binding WriteIndustrialLocalCommand}" IsEnabled="{Binding IndustrialServerRunning}" Margin="0,0,8,8"/></WrapPanel>
<TextBox Text="{Binding IndustrialResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65"/>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding IndustrialMemoryPath}"/><arc:Button Grid.Column="1" Content="保存数据池" Command="{Binding SaveIndustrialMemoryCommand}" IsEnabled="{Binding IndustrialServerRunning}" Margin="8,0"/><arc:Button Grid.Column="2" Content="恢复数据池" Command="{Binding LoadIndustrialMemoryCommand}" IsEnabled="{Binding IndustrialServerRunning}"/></Grid>
<TextBlock Text="本页已接入基础类型、数组、字符串及数据池；各厂家路由参数、专用命令和扩展页仍按官方页面逐项迁移。" Classes="caption" TextWrapping="Wrap"/>
<TextBox Text="{Binding IndustrialLog}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Height="180"/>
</StackPanel></TabItem>
<TabItem Header="协议目录"><StackPanel Spacing="12" Margin="0,14">
<TextBlock Text="官方协议迁移目录" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="设备族索引；支持范围以状态列和已验收用例为准。机械手及其他专用页面仍待迁移。" Classes="caption" TextWrapping="Wrap"/>
<Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ProtocolSearch}" PlaceholderText="搜索 PLC、Robot、厂家或协议，例如 Siemens / ABB / FINS"/><arc:Button Grid.Column="1" Content="打开已接入页面" Command="{Binding OpenCatalogProtocolCommand}" Margin="8,0"/></Grid>
<DataGrid ItemsSource="{Binding FilteredProtocols}" SelectedItem="{Binding SelectedProtocol}" AutoGenerateColumns="False" IsReadOnly="True" Height="380" CanUserResizeColumns="True"><DataGrid.Columns>
<DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="80"/><DataGridTextColumn Header="厂家" Binding="{Binding Vendor}" Width="140"/><DataGridTextColumn Header="协议 / 型号" Binding="{Binding Product}" Width="210"/><DataGridTextColumn Header="传输" Binding="{Binding Transport}" Width="150"/><DataGridTextColumn Header="迁移状态" Binding="{Binding Status}" Width="240"/><DataGridTextColumn Header="官方源码入口（HslCommunicationDemo 下）" Binding="{Binding Source}" Width="310"/>
</DataGrid.Columns></DataGrid>
</StackPanel></TabItem>
</TabControl>
<Border Background="#192630" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="操作结果" Classes="caption"/><TextBox Text="{Binding Result}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="50"/><TextBlock Text="运行日志 · 最近 500 条" Classes="caption"/><ListBox ItemsSource="{Binding Logs}" Height="140" FontFamily="Consolas" FontSize="12"/></StackPanel></Border>
</StackPanel></ScrollViewer><TextBlock Grid.Row="2" Grid.Column="1" Text="TCP / HSL 13.0.3    ·    ASCII / ANSI / UTF-8 / UTF-16 / GB2312    ·    Avalonia + Arc" Classes="caption" Margin="26,8"/>
</Grid></Window>

